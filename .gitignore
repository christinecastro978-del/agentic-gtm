# Attendee files are committed to this private repo (owner decision, 2026-10-08).
# Keys and filled config still stay outside the project; the rules below keep them out.
*.env
.env*
!api-templates/credentials.env.example
*token*.json
*credentials*.json
__pycache__/
*.py[cod]
.venv/
.DS_Store
.tmp/
# Clean database is included; never commit populated working records.
code/data/*-journal
code/data/*-wal
code/data/*-shm
